# ==============================================================================
# AI TRADING BOT 2 — Environment Variables Template
# ==============================================================================

# MetaApi.cloud Credentials (MT5 Headless on Linux - Alternative Cloud Option)
# Get your token and account ID at https://app.metaapi.cloud
METAAPI_TOKEN=your_metaapi_token_here
METAAPI_ACCOUNT_ID=your_metaapi_account_id_here

# Discord Command Center & Real-time Notifications
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# AI Macroeconomic Sentiment Engines
# Groq provides ultra-fast inference (Qwen/Llama) with automatic fallback to Gemini
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Local Docker MT5 Credentials (0 Baht Ubuntu Server Option via Wine + RPyC)
MT5_LOGIN=your_mt5_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=MetaQuotes-Demo
MT5_DOCKER_HOST=127.0.0.1
MT5_DOCKER_PORT=18812
